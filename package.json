{
  "name": "settlement-truth",
  "version": "1.0.0",
  "description": "Settlement Truth - Evidence-first AI Finance Controller for merchants (React + Node.js)",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "fintech",
    "reconciliation",
    "razorpay",
    "react",
    "nodejs",
    "express"
  ],
  "author": "",
  "license": "MIT"
}
