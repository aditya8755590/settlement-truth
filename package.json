    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "express": "^4.21.2",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.41.0",
    "multer": "^2.3.0",
    "postcss": "^8.5.28",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "fintech",
